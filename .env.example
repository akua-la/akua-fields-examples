# Credenciales de sandbox (client_credentials) — nunca las pongas en el navegador.
# server.js las usa para mintear el token y crear/reusar tu clave de Dual Encryption.
AKUA_CLIENT_ID=
AKUA_CLIENT_SECRET=

# Opcional — default: https://sandbox.akua.la
# AKUA_BASE=https://sandbox.akua.la

# Opcional — puerto del server local (default: 4000)
# PORT=4000
